{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhatsApp",
  "version": "0.1.0",
  "identifier": "com.whatsapp.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "WhatsApp v0.1.0",
        "label": "main",
        "width": 1150,
        "height": 780,
        "minWidth": 650,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "userAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36",
        "url": "https://web.whatsapp.com"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
